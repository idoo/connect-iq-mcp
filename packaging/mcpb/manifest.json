{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-latest.schema.json",
  "manifest_version": "0.3",
  "name": "ciq-mcp",
  "display_name": "Connect IQ MCP",
  "version": "0.0.0",
  "description": "MCP server for Garmin Connect IQ developers. Ask Claude about your store apps, SDK builds and the simulator. Read-only by default.",
  "long_description": "MCP server for Garmin Connect IQ developers. Ask Claude about your store apps, SDK builds and the simulator. Read-only by default; anything public waits for your yes. Run `ciq-mcp auth login` once to store credentials.",
  "author": {
    "name": "Ivan Verevkin",
    "url": "https://github.com/idoo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/idoo/ciq-mcp"
  },
  "homepage": "https://github.com/idoo/ciq-mcp",
  "documentation": "https://github.com/idoo/ciq-mcp#readme",
  "support": "https://github.com/idoo/ciq-mcp/issues",
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "garmin",
    "connect-iq",
    "monkey-c",
    "wearables",
    "smartwatch"
  ],
  "server": {
    "type": "binary",
    "entry_point": "server/ciq-mcp-darwin",
    "mcp_config": {
      "command": "${__dirname}/server/ciq-mcp-darwin",
      "args": [
        "serve"
      ],
      "env": {
        "CIQ_MCP_ALLOW_WRITES": "${user_config.allow_writes}",
        "CIQ_MCP_TOOLSETS": "${user_config.toolsets}"
      },
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/ciq-mcp-windows-amd64.exe"
        },
        "linux": {
          "command": "${__dirname}/server/ciq-mcp-linux"
        }
      }
    }
  },
  "tools_generated": true,
  "prompts_generated": false,
  "prompts": [],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "user_config": {
    "allow_writes": {
      "type": "boolean",
      "title": "Allow writes",
      "description": "Expose write and destructive tools. Destructive actions still require plan/confirm.",
      "required": false,
      "default": false
    },
    "toolsets": {
      "type": "string",
      "title": "Toolsets",
      "description": "Empty for the defaults, 'all', or e.g. '+connect'.",
      "required": false,
      "default": ""
    }
  }
}
